# Generate a long random value for each environment; never use this placeholder in production.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Required service configuration (supply environment-specific values).
DATABASE_URL=postgresql://user:password@host:5432/database
BREVO_API_KEY=replace-with-brevo-api-key
SMTP_FROM_EMAIL=no-reply@example.com
ERP_CREATE_USER_ENABLED=false
ERP_BASE_URL=https://erp.example.com
CRM_ERP_API_KEY=replace-with-a-long-random-integration-key
